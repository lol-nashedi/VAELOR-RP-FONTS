-- keyboard typing: every typed / pasted symbol is added just like a tapped one
local function isMod(cp)
	return cp == 0xFE0F or cp == 0xFE0E or cp == 0x200D or cp == 0x20E3 or (cp >= 0x1F3FB and cp <= 0x1F3FF)
		or (cp >= 0x0300 and cp <= 0x036F) or (cp >= 0xE0020 and cp <= 0xE007F)
end
local function splitSymbols(str)
	local out, joiner = {}, false
	for _, cp in utf8.codes(str) do
		local ch = utf8.char(cp)
		if cp == 32 or cp == 9 or cp == 10 or cp == 13 then
			joiner = false
		elseif #out > 0 and (joiner or isMod(cp)) then
			out[#out] = out[#out] .. ch
			joiner = (cp == 0x200D)
		else
			table.insert(out, ch)
			joiner = false
		end
	end
	return out
end
local function addTyped()
	local txt = typeBox.Text
	if not txt:match("%S") then return end
	local ok, list = pcall(splitSymbols, txt)
	if not ok then
		status.Text = "Could not read that text."
		return
	end
	local added = 0
	for _, g in ipairs(list) do
		if #symbols >= MAX_SYMBOLS then break end
		table.insert(symbols, g)
		added += 1
	end
	typeBox.Text = ""
	if added < #list then
		status.Text = "Max " .. MAX_SYMBOLS .. " symbols. Added " .. added .. ", use Undo or Clear."
	elseif side then
		status.Text = "Added " .. added .. " typed symbol(s)."
	else
		status.Text = "Added " .. added .. " typed symbol(s). Placed on the left. Tap Left / Right / Both to change."
	end
	updateSymBar()
	updatePreview()
end
typeAdd.MouseButton1Click:Connect(addTyped)
typeBox.FocusLost:Connect(function(enter)
	if enter then addTyped() end
end)

