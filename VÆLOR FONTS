----------------------------------------------------------------
local function mapStyle(tbl, upperToo)
	return function(ch)
		return tbl[ch] or (upperToo and tbl[ch:lower()]) or ch
	end
end
local function rangeStyle(U, L, D)
	return function(ch)
		local cp = utf8.codepoint(ch)
		if cp >= 65 and cp <= 90 then return utf8.char(U + (cp - 65)) end
		if cp >= 97 and cp <= 122 then return utf8.char(L + (cp - 97)) end
		if D and cp >= 48 and cp <= 57 then return utf8.char(D + (cp - 48)) end
		return ch
	end
end
-- lower / upper are 26-item lists (a-z / A-Z). "" keeps the normal letter. No upper list = use the lower one for capitals too.
local function fromLists(lower, upper, digits)
	local t = {}
	local lo = "abcdefghijklmnopqrstuvwxyz"
	for i = 1, 26 do
		local l = lower[i]
		if l and l ~= "" then t[lo:sub(i, i)] = l end
		local u = upper and upper[i]
		if u and u ~= "" then t[lo:sub(i, i):upper()] = u end
	end
	if digits then
		for i = 0, 9 do
			if digits[i + 1] then t[tostring(i)] = digits[i + 1] end
		end
	end
	return mapStyle(t, upper == nil)
end

