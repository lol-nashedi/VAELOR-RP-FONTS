local function fadeOut(root, t)
	local info = TweenInfo.new(t, Enum.EasingStyle.Quad)
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("TextLabel") then
			TweenService:Create(d, info, { TextTransparency = 1 }):Play()
		elseif d:IsA("ImageLabel") then
			TweenService:Create(d, info, { ImageTransparency = 1, BackgroundTransparency = 1 }):Play()
		elseif d:IsA("Frame") then
			TweenService:Create(d, info, { BackgroundTransparency = 1 }):Play()
		elseif d:IsA("UIStroke") then
			TweenService:Create(d, info, { Transparency = 1 }):Play()
		end
	end
	TweenService:Create(root, info, { BackgroundTransparency = 1 }):Play()
end

local function announce()
	local msg = "VÆLOR FONTS SCRIPT LOADED"
	local sent = false
	if ANNOUNCE_PUBLIC then
		pcall(function()
			if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
				TextChatService:WaitForChild("TextChannels", 5):WaitForChild("RBXGeneral", 5):SendAsync(msg)
			else
				ReplicatedStorage:WaitForChild("DefaultChatSystemChatEvents", 5):WaitForChild("SayMessageRequest", 5):FireServer(msg, "All")
			end
			sent = true
		end)
	end
	if not sent then
		-- local-only fallback (only you can see it)
		local ok = pcall(function()
			TextChatService.TextChannels.RBXGeneral:DisplaySystemMessage(msg)
		end)
		if not ok then
			pcall(function()
				game:GetService("StarterGui"):SetCore("ChatMakeSystemMessage", { Text = msg, Color = Color3.fromRGB(255, 70, 90) })
			end)
		end
	end
end

