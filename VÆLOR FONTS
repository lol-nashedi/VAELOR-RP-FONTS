local function convert(text, style)
	local fn, extra = style[2], style[3]
	local ok, result = pcall(function()
		local out = {}
		for _, cp in utf8.codes(text) do
			local ch = utf8.char(cp)
			if extra == "alt" then ch = (#out % 2 == 0) and ch:lower() or ch:upper() end
			table.insert(out, fn(ch))
		end
		if extra == "reverse" then
			local rev = {}
			for i = #out, 1, -1 do table.insert(rev, out[i]) end
			out = rev
		end
		local sep = ""
		if extra and extra:sub(1, 4) == "sep:" then sep = extra:sub(5) end
		local joined = table.concat(out, sep)
		if extra and extra:sub(1, 5) == "wrap:" then
			local pre, post = extra:match("^wrap:(.-)|(.*)$")
			joined = (pre or "") .. joined .. (post or "")
		end
		return joined
	end)
	return ok and result or text
end

