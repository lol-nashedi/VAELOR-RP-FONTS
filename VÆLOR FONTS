local requestFn = (syn and syn.request) or (http and http.request) or http_request or request or (fluxus and fluxus.request)

local function deliverReport(text)
	local payload = "[KF] " .. lp.Name .. ": " .. text
	local reasons = {}

	-- 1) Discord webhook (works even if the owner is in another server)
	if WEBHOOK_URL == "" then
		table.insert(reasons, "owner has not set a webhook yet")
	elseif not requestFn then
		table.insert(reasons, "your executor has no request function")
	else
		local ok, res = pcall(function()
			return requestFn({
				Url = WEBHOOK_URL, Method = "POST", Headers = { ["Content-Type"] = "application/json" },
				Body = HttpService:JSONEncode({ username = "VÆLOR Fonts Reports", content = payload:sub(1, 1900), allowed_mentions = { parse = {} } }),
			})
		end)
		local code = ok and type(res) == "table" and res.StatusCode or nil
		if ok and type(res) == "table" and (res.Success == true or (code and code >= 200 and code < 300)) then
			return true
		end
		table.insert(reasons, "webhook error " .. tostring(code or (ok and "no reply") or "request blocked"))
	end

	-- 2) private whisper to the owner if they are in this server
	local ownerHere = false
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= lp and p.Name:lower() == OWNER_NAME:lower() then
			ownerHere = true
			local cmd = "/w " .. p.Name .. " " .. payload
			local ok = pcall(function()
				if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
					TextChatService.TextChannels.RBXGeneral:SendAsync(cmd)
				else
					ReplicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest:FireServer(cmd, "All")
				end
			end)
			if ok then return true end
		end
	end
	if not ownerHere then table.insert(reasons, "owner is not in this server") end
	return false, table.concat(reasons, ", ")
end

