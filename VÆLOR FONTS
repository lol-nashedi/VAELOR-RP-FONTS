local THEME_KEYS = { "bg2", "bg", "panel", "field", "text", "sub", "line", "accent", "good" }
local swatchStrokes = {}

local function applyTheme(name)
	local t = THEMES[name]
	if not t then return end
	local list = {}
	for _, k in ipairs(THEME_KEYS) do table.insert(list, { C[k], t[k] }) end
	local function map(c)
		for _, p in ipairs(list) do
			if c == p[1] then return p[2] end
		end
		return nil
	end
	local function fix(o)
		if o.Name == "Swatch" or o:GetAttribute("NoTheme") then return end
		if o:IsA("GuiObject") then
			local n = map(o.BackgroundColor3)
			if n then o.BackgroundColor3 = n end
		end
		if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then
			local n = map(o.TextColor3)
			if n then o.TextColor3 = n end
		end
		if o:IsA("TextBox") then
			local n = map(o.PlaceholderColor3)
			if n then o.PlaceholderColor3 = n end
		end
		if o:IsA("UIStroke") then
			local n = map(o.Color)
			if n then o.Color = n end
		end
	end
	for _, d in ipairs(main:GetDescendants()) do fix(d) end
	fix(main)
	fix(circle)

	local g = main:FindFirstChildOfClass("UIGradient")
	if g then g.Color = ColorSequence.new(t.bg2, t.bg) end

	bgAlpha = t.alpha * 0.8
	main.BackgroundTransparency = t.alpha
	for _, d in ipairs(main:GetDescendants()) do
		if d:IsA("GuiObject") and d.Name ~= "Swatch" and not d:GetAttribute("NoTheme") and d.BackgroundTransparency < 0.99 then
			d.BackgroundTransparency = bgAlpha
		end
	end
	for _, k in ipairs(THEME_KEYS) do C[k] = t[k] end

	for n, st in pairs(swatchStrokes) do
		st.Color = (n == name) and C.red or Color3.new(1, 1, 1)
		st.Thickness = (n == name) and 2.5 or 1
	end
end

